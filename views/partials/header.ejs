    "url": "https://coolcruze.in",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://coolcruze.in/products?search={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    },
    "publisher": { "@type": "Organization", "@id": "https://coolcruze.in/#organization" }
  }
  </script>

  <!-- WebPage Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "<%= typeof pageTitle !== 'undefined' ? pageTitle : 'Cool Cruze' %> | Cool Cruze",
    "description": "<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Tower AC rental Mumbai — commercial ACs on rent across MMR. Zero deposit, free installation.' %>",
    "url": "https://coolcruze.in<%= currentPath %>",
    "isPartOf": { "@id": "https://coolcruze.in/#website" },
    "about": { "@id": "https://coolcruze.in/#localbusiness" },
    "inLanguage": "en-IN",
    "datePublished": "<%= typeof pageDate !== 'undefined' ? pageDate : new Date().toISOString().split('T')[0] %>",
    "dateModified": "<%= typeof pageModified !== 'undefined' ? pageModified : new Date().toISOString().split('T')[0] %>"
  }
