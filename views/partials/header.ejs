  <!-- Organization Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Cool Cruze",
    "url": "https://coolcruze.in",
    "logo": "https://coolcruze.in/icons/icon.svg",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+<%= whatsappNumber %>",
      "contactType": "customer service",
      "availableLanguage": ["en", "hi"]
    },
    "sameAs": ["https://wa.me/<%= whatsappNumber %>"],
    "description": "Best tower AC rental in Mumbai. Heavy-duty commercial tower, portable & ductable ACs on rent. Zero deposit, free installation & 24/7 support."
  }
  </script>

  <!-- LocalBusiness Schema - Mumbai, Thane, Navi Mumbai, Kharghar, Vashi, Virar Service Area -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://coolcruze.in/#localbusiness",
    "name": "Cool Cruze",
    "description": "Premium tower AC rental service in Mumbai, Thane, Navi Mumbai, Kharghar, Vashi, Virar and surrounding areas. Heavy-duty commercial ACs for events, offices, warehouses & industries.",
    "url": "https://coolcruze.in",
    "telephone": "+<%= whatsappNumber %>",
    "email": "info@coolcruze.in",
    "logo": "https://coolcruze.in/icons/icon.svg",
    "image": "https://coolcruze.in/uploads/hero.png",
    "priceRange": "₹₹",
    "currenciesAccepted": "INR",
    "paymentAccepted": "Cash, UPI, Bank Transfer, Card",
    "areaServed": [
      { "@type": "City", "name": "Mumbai", "@id": "https://en.wikipedia.org/wiki/Mumbai" },
      { "@type": "City", "name": "Thane", "@id": "https://en.wikipedia.org/wiki/Thane" },
      { "@type": "City", "name": "Navi Mumbai", "@id": "https://en.wikipedia.org/wiki/Navi_Mumbai" },
      { "@type": "AdministrativeArea", "name": "Kharghar", "containedInPlace": { "@type": "City", "name": "Navi Mumbai" } },
      { "@type": "AdministrativeArea", "name": "Vashi", "containedInPlace": { "@type": "City", "name": "Navi Mumbai" } },
      { "@type": "City", "name": "Virar", "@id": "https://en.wikipedia.org/wiki/Virar" }
    ],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mumbai",
      "addressRegion": "Maharashtra",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "19.0760",
      "longitude": "72.8777"
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], "opens": "09:00", "closes": "20:00" }
    ],
    "serviceType": "AC Rental",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "AC Rental Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Tower AC Rental", "description": "Heavy-duty commercial tower AC rental for events, offices & industries" }, "priceCurrency": "INR", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Portable AC Rental", "description": "Portable air conditioner rental for temporary cooling needs" }, "priceCurrency": "INR", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ductable AC Rental", "description": "Ductable AC rental for commercial spaces and large areas" }, "priceCurrency": "INR", "availability": "https://schema.org/InStock" },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cassette AC Rental", "description": "Cassette AC rental for offices and commercial spaces" }, "priceCurrency": "INR", "availability": "https://schema.org/InStock" }
      ]
    },
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "reviewCount": "127" }
